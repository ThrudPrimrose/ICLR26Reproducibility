#!/bin/bash
# nvcc wrapper for the Daint regrade (bin/ is first on PATH via env.sh, so the harness resolves this).
# The harness links GPU shared libraries with a raw "-Wl,<opts>" (e.g. -Wl,-rpath,/shared/lib), which
# hipcc (clang) accepts and nvcc rejects ("nvcc fatal: Unknown option '-Wl,-rpath,...'"). Each such
# token is rewritten to nvcc's own spelling, -Xlinker=<opts>; every other argument passes unchanged.
self=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
real=""
IFS=: read -ra dirs <<< "$PATH"
for d in "${dirs[@]}"; do
    [[ -n $d && $(cd "$d" 2>/dev/null && pwd) != "$self" && -x $d/nvcc ]] && { real=$d/nvcc; break; }
done
[[ -n $real ]] || { echo "bin/nvcc wrapper: no real nvcc on PATH" >&2; exit 127; }
args=()
for a in "$@"; do
    if [[ $a == -Wl,* ]]; then
        args+=("-Xlinker=${a#-Wl,}")
    elif [[ $a == *.cpp && -f $a ]] && grep -q 'hip/hip_runtime\|hipLaunchKernelGGL' "$a"; then
        # hipcc compiles a .cpp as HIP (device code and launches allowed); nvcc compiles it as
        # host-only C++ unless told otherwise. A HIP host unit is therefore built as CUDA.
        args+=(-x cu "$a")   # nvcc -x applies to every input; the harness compiles one unit per call
    else
        args+=("$a")
    fi
done
exec "$real" "${args[@]}"
